  public void reservarAula(Scanner teclado) throws HorarioConflictivoException  {
    
    System.out.print("Nombre del aula: ");
    String nombreAula = teclado.nextLine().trim(); 
    
    Aula aula = mapaAulas.get(nombreAula);

    if (aula == null) {
        System.out.println("Error: El aula no existe.");
        return;
    }

    // --- VALIDACIÓN DEL DÍA (1 al 7) ---
    int diaInput = 0;
    while (diaInput < 1 || diaInput > 7) {
        System.out.print("Día (1=Lunes ... 7=Domingo): ");
        diaInput = teclado.nextInt();
        teclado.nextLine(); // Limpiar buffer
        
        if (diaInput < 1 || diaInput > 7) {
            System.out.println("Error: El día debe estar entre 1 y 7. Intente de nuevo.");
        }
    }
  
    int diaMatriz = (diaInput == 7) ? 0 : diaInput;

    // --- VALIDACIÓN DE LA HORA (0 al 23) ---
    int hora = -1;
    while (hora < 0 || hora > 23) {
        System.out.print("Hora de inicio (0 a 23): ");
        hora = teclado.nextInt();
        teclado.nextLine();
        
        if (hora < 0 || hora > 23) {
            System.out.println("Error: La hora debe estar entre 0 y 23. Intente de nuevo.");
        }
    }

    //  VALIDACIÓN DE LA DURACIÓN 
    int duracion = 0;
    // Validar que la duración no pase de las 3 horas máximas y tampoco se pase de las 24 horas del día
    while (duracion < 1 || duracion > 3 || (hora + duracion) > 24) {
        System.out.print("Duración en horas (máximo 3): ");
        duracion = teclado.nextInt();
        teclado.nextLine();
        
        if (duracion < 1 || duracion > 3) {
            System.out.println("Error: La duración debe ser como máximo 3 horas.");
        } else if ((hora + duracion) > 24) {
            System.out.println("Error: La duración es inválida o se pasa de las 24 horas del día.");
        }
    }

    // Llamar al método reservar de la clase Aula
    aula.reservar(diaMatriz, hora, duracion);
}
    
