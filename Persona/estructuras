public void registrarEstudiante (Scanner teclado){
    //Necesito variables temporales
    
    System.out.println("Registrar ID: ");
    String id = teclado.nextLine().trim();
    
    //Condicional para saber si el id ya se encuentra ocupado
    if(mapaEstudiantes.containsKey(id)){
        System.out.println("Error ya existe un estudiante con esta ID");   
        return;
    }
    
    System.out.println("Registrar Nombre: ");
    String name = teclado.nextLine();
    
    System.out.println("Registrar Email:");
    String email = teclado.nextLine();
    
  // Semestre de 1 a 10 no más ni menos
    int semestre = 0; 
    // El while se repetirá hasta que el semestre esté entre 1 y 10
    while (semestre < 1 || semestre > 10) {
        System.out.println("Registrar semestre (1 al 10):");
        semestre = teclado.nextInt();
        teclado.nextLine(); // Limpiar buffer
        
        if (semestre < 1 || semestre > 10) {
            System.out.println("Error: El semestre debe ser entre 1 y 10. Intente de nuevo.");
        }
    }
    // ---------------------------
    
    //Creo el objeto estudiante con esos datos
    
    Estudiante estudiante = new Estudiante (name, id, email, semestre); //Objeto estudiante 
    
    
    //Guardo en el hashMap
    
    mapaEstudiantes.put(id, estudiante);
    
    System.out.println("Estudiante registrado con exito");
    
}


