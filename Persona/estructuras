    // El Algoritmo de Dijkstra
    public void calcularRutaMasCorta(Scanner teclado) {
        System.out.println("Edificios: " + String.join(" | ", nombresEdificios));
        System.out.print("Edificio Origen (0-4): ");
        int origen = teclado.nextInt();
        System.out.print("Edificio Destino (0-4): ");
        int destino = teclado.nextInt();
        teclado.nextLine();

        int[] distancias = new int[numEdificios];
        boolean[] visitados = new boolean[numEdificios];
        int[] anteriores = new int[numEdificios]; // Para saber por dónde vinimos

        // Inicializar arreglos
        for (int i = 0; i < numEdificios; i++) {
            distancias[i] = 999999;
            visitados[i] = false;
            anteriores[i] = -1;
        }
        distancias[origen] = 0;

        // Ciclo principal de Dijkstra
        for (int i = 0; i < numEdificios; i++) {
            // Buscar el edificio NO visitado con la distancia más corta
            int actual = -1;
            int distanciaMinima = 999999;
            for (int j = 0; j < numEdificios; j++) {
                if (!visitados[j] && distancias[j] < distanciaMinima) {
                    distanciaMinima = distancias[j];
                    actual = j;
                }
            }

            if (actual == -1) break; // Si no hay más caminos, salir
            visitados[actual] = true;

            // Actualizar distancias de los vecinos
            for (int vecino = 0; vecino < numEdificios; vecino++) {
                if (matrizDistancias[actual][vecino] != 999999 && !visitados[vecino]) {
                    int nuevaDistancia = distancias[actual] + matrizDistancias[actual][vecino];
                    if (nuevaDistancia < distancias[vecino]) {
                        distancias[vecino] = nuevaDistancia;
                        anteriores[vecino] = actual; // Guardar de dónde inicie
                    }
                }
            }
        }

        // Mostrar resultados
        if (distancias[destino] == 999999) {
            System.out.println("No hay ruta entre estos edificios.");
            return;
        }

        System.out.println("\n--- RESULTADO ---");
        System.out.println("Distancia TOTAL: " + distancias[destino] + " metros");
        
        // Reconstruir el camino
        System.out.print("Ruta más corta: ");
        int paso = destino;
        String camino = nombresEdificios[paso];
        while (paso != origen) {
            paso = anteriores[paso];
            camino = nombresEdificios[paso] + " -> " + camino;
        }
        System.out.println(camino);
    }
    
       public void registrarNotaEstudiante(Scanner teclado) throws EstudianteNoEncontradoException {
        // Se limpia el texto con .trim() para evitar espacios en blanco
        System.out.print("ID del estudiante: ");
        String id = teclado.nextLine().trim(); 
        
        Estudiante est = mapaEstudiantes.get(id);
        if (est == null) {
            throw new EstudianteNoEncontradoException("El estudiante no existe.");
        }

        // --- VALIDACIÓN DEL SEMESTRE (1 al 10) ---
        int semestre = 0;
        while (semestre < 1 || semestre > 10) {
            System.out.print("Semestre (1 al 10): ");
            semestre = teclado.nextInt();
            teclado.nextLine(); // Limpiar buffer
            
            if (semestre < 1 || semestre > 10) {
                System.out.println("Error: El semestre debe estar entre 1 y 10.");
            }
        }
        
        // --- VALIDACIÓN DE LA MATERIA (0 al 19) ---
        int materia = -1;
        while (materia < 0 || materia > 19) {
            System.out.print("Número de materia (0 al 19): ");
            materia = teclado.nextInt();
            teclado.nextLine(); // Limpiar buffer
            
            if (materia < 0 || materia > 19) {
                System.out.println("Error: La materia debe estar entre 0 y 19.");
            }
        }
        
        // --- VALIDACIÓN DE LA NOTA (1.0 a 5.0) ---
        double nota = -1;
        while (nota < 1.0 || nota > 5.0) {
            System.out.print("Nota (1.0 a 5.0): ");
            nota = teclado.nextDouble();
            teclado.nextLine(); // Limpiar buffer
            
            if (nota < 1.0 || nota > 5.0) {
                System.out.println("Error: La nota debe estar entre 1.0 y 5.0.");
            }
        }

        // GUARDO LA NOTA ANTERIOR (por si había una)
        // Se usan las variables 'semestre' y 'materia'
        Double notaVieja = est.getNota(semestre, materia);

        // Se llama al método registrarNota de la clase Estudiante
        est.registrarNota(semestre, materia, nota);
        
        // Se guarda el cambio en la pila de deshacer
        pilaDeshacer.push(new Cambio(Cambio.Tipo.REGISTRAR_NOTA, est, semestre, materia, notaVieja, nota));
        pilaRehacer.clear();

        System.out.println("Nota registrada exitosamente.");
    }
     // MÓDULO BATCH (Leer archivo CSV)
    public void procesarArchivoBatch(String nombreArchivo) throws ArchivoInvalidoException {
        // Uso una Cola (Queue) para procesar las solicitudes una por una
        java.util.Queue<String> colaSolicitudes = new java.util.ArrayDeque<>();
        int exitosas = 0;
        int fallidas = 0;

        // 1. LEER EL ARCHIVO Y LLENAR LA COLA
        try (java.io.BufferedReader br = new java.io.BufferedReader(new java.io.FileReader(nombreArchivo))) {
            String linea;
            while ((linea = br.readLine()) != null) {
                if (!linea.trim().isEmpty()) {
                    colaSolicitudes.offer(linea); // Meter cada solicitud al final de la cola
                }
            }
        } catch (java.io.FileNotFoundException e) {
            // Si el archivo no existe, lanzar la excepción personalizada
            throw new ArchivoInvalidoException("El archivo '" + nombreArchivo + "' no existe o está en otra carpeta.");
        } catch (java.io.IOException e) {
            throw new ArchivoInvalidoException("Error al leer el archivo: " + e.getMessage());
        }

        System.out.println("\n--- PROCESANDO LOTE (BATCH) ---");
        System.out.println("Solicitudes encontradas en el archivo: " + colaSolicitudes.size());
        System.out.println("Procesando cola...");

        // 2. PROCESAR LA COLA
        while (!colaSolicitudes.isEmpty()) {
            String solicitud = colaSolicitudes.poll(); // Sacar al primero de la fila
            String[] partes = solicitud.split(","); // Separar el ID y el Código por la coma

            if (partes.length == 2) {
                String idEstudiante = partes[0].trim();
                int codigoMateria;
                
                try {
                    codigoMateria = Integer.parseInt(partes[1].trim());
                    Estudiante est = mapaEstudiantes.get(idEstudiante);
                    Materia mat = mapaMaterias.get(codigoMateria);

                    if (est == null || mat == null) {
                        System.out.println("[FALLIDA] " + solicitud + " -> El ID o la materia no existen.");
                        fallidas++;
                    } else {
                        // Intento inscribir
                        mat.inscribirEstudiante(est);
                        exitosas++;
                    }
                } catch (NumberFormatException e) {
                    System.out.println("[FALLIDA] " + solicitud + " -> Formato de código incorrecto.");
                    fallidas++;
                } catch (Exception e) {
                    // Si Materia lanza error (ej: CupoLlenoException o PreRequisitoNoAprobado)
                    System.out.println("[FALLIDA] " + solicitud + " -> " + e.getMessage());
                    fallidas++;
                }
            } else {
                System.out.println("[FALLIDA] " + solicitud + " -> Formato de línea incorrecto.");
                fallidas++;
            }
        }

        // 3. MOSTRAR RESUMEN
        System.out.println("\n=== RESUMEN DEL LOTE ===");
        System.out.println("Inscripciones exitosas: " + exitosas);
        System.out.println("Inscripciones fallidas: " + fallidas);
    }
    
    public void registrarProfesor(Scanner teclado) {     //Metodo para registrar profesor
        System.out.print("ID del profesor: ");
        String id = teclado.nextLine();
        
        if (mapaProfesores.containsKey(id)) {
            System.out.println("Error: ID ya existe.");
            return;
        }
        
        System.out.print("Nombre: ");
        String nombre = teclado.nextLine();
        System.out.print("Email: ");
        String email = teclado.nextLine();
        System.out.print("Departamento: "); //Departamento de ingenieria
        String departamento = teclado.nextLine();
        System.out.print("Salario: ");
        double salario = teclado.nextDouble();
        teclado.nextLine();

        Profesor profe = new Profesor(nombre, id, email, departamento, salario);
        mapaProfesores.put(id, profe);
        System.out.println("Profesor registrado con éxito.");
        
    }
    
     // Método para agregar un pre-requisito a una materia
    public void agregarPrerequisitoAMateria(Scanner teclado) {
        System.out.print("Código de la materia a la que le vas a agregar el pre-requisito: ");
        int codigoMateria = teclado.nextInt();
        teclado.nextLine();
        
        Materia mat = mapaMaterias.get(codigoMateria);
        if (mat == null) {
            System.out.println("Error: La materia no existe.");
            return;
        }

        System.out.print("Código de la materia que será el PRE-REQUISITO: ");
        int codigoReq = teclado.nextInt();
        teclado.nextLine();

        Materia req = mapaMaterias.get(codigoReq);
        if (req == null) {
            System.out.println("Error: La materia pre-requisito no existe.");
            return;
        }

        // Llamar al método de la clase Materia
        mat.agregarPreRequisitos(req);
        System.out.println("Pre-requisito agregado exitosamente.");
    }
