       public void deshacer() throws PilaDeshacerVaciaException {
        if (pilaDeshacer.isEmpty()) {
            throw new PilaDeshacerVaciaException("No hay cambios por deshacer");
        }
        Cambio ultimoCambio = pilaDeshacer.pop();
        System.out.println("Deshaciendo el último cambio: " + ultimoCambio.getTipo());

        if (ultimoCambio.getTipo() == Cambio.Tipo.ELIMINAR_ESTUDIANTE) {
            // Se revierte, se vuelve a meter al hashmap
            mapaEstudiantes.put(ultimoCambio.getEstudiante().getId(), ultimoCambio.getEstudiante());
            System.out.println("Estudiante restaurado en el sistema");
        } 
        
        else if (ultimoCambio.getTipo() == Cambio.Tipo.INSCRIBIR) {
            // Se revierte, se le quita la materia y se devuelve el cupo 
            ultimoCambio.getEstudiante().getHistorialMaterias().remove(ultimoCambio.getMateria().getNombreMat());
            ultimoCambio.getMateria().setCuposDisp(ultimoCambio.getMateria().getCuposDisp() + 1);
            System.out.println("Incripción cancelada cupo devuelto");
        } 
        
        else if (ultimoCambio.getTipo() == Cambio.Tipo.REGISTRAR_NOTA) {
            // Se revierte: se vuelve a poner la nota que estaba antes (si no había, se pone 0.0)
            Double notaVieja = ultimoCambio.getNotaAnterior();
            
            if (notaVieja != null) {
                ultimoCambio.getEstudiante().registrarNota(
                    ultimoCambio.getSemestreNota(), 
                    ultimoCambio.getMateriaNota(), 
                    notaVieja
                );
            } else {
                ultimoCambio.getEstudiante().registrarNota(
                    ultimoCambio.getSemestreNota(), 
                    ultimoCambio.getMateriaNota(), 
                    0.0 
                );
            }
            System.out.println("Nota revertida a su estado anterior");
        }

        pilaRehacer.push(ultimoCambio); //Se mueve a la pila Rehacer
    }
    
    public void rehacer() throws PilaDeshacerVaciaException {
        if (pilaRehacer.isEmpty()) {
           throw new PilaDeshacerVaciaException("No hay cambios por rehacer");
        }
        Cambio cambioARehacer = pilaRehacer.pop();
        System.out.println("Rehacer cambio: " + cambioARehacer.getTipo());
        
        if (cambioARehacer.getTipo() == Cambio.Tipo.ELIMINAR_ESTUDIANTE) {
            mapaEstudiantes.remove(cambioARehacer.getEstudiante().getId());
            System.out.println("Estudiante eliminado nuevamente");
        } 
        
        else if (cambioARehacer.getTipo() == Cambio.Tipo.INSCRIBIR) {
            cambioARehacer.getEstudiante().getHistorialMaterias().add(cambioARehacer.getMateria().getNombreMat());
            cambioARehacer.getMateria().setCuposDisp(cambioARehacer.getMateria().getCuposDisp() - 1);
            System.out.println("Estudiante inscrito nuevamente en la materia");
        } 
        
        else if (cambioARehacer.getTipo() == Cambio.Tipo.REGISTRAR_NOTA) {
            // Se rehace: se vuelve a poner la nota nueva que se había registrado
            cambioARehacer.getEstudiante().registrarNota(
                cambioARehacer.getSemestreNota(), 
                cambioARehacer.getMateriaNota(), 
                cambioARehacer.getNotaNueva()
            );
            System.out.println("Nota registrada nuevamente");
        }

        pilaDeshacer.push(cambioARehacer);  //Lo devuelvo a la pila de deshacer
    }
    
