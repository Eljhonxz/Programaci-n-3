public void crearMateria (Scanner teclado){
    System.out.println("Codigo de la materia (número): ");
    int codigo = teclado.nextInt();
    teclado.nextLine();
    
    if(mapaMaterias.containsKey(codigo)){
        System.out.println("Error ya existe una materia con ese código");
        return;
    }
    
    System.out.println("Nombre de la materia: ");
    String nombreMat = teclado.nextLine();
    
    // --- VALIDACIÓN DE CUPOS ---
    int cupos = 0;
    while (cupos < 1 || cupos > 40) {
        System.out.println("Cupos máximos disponibles (1 al 40): ");
        cupos = teclado.nextInt();
        teclado.nextLine();
        
        if (cupos < 1 || cupos > 40) {
            System.out.println("Error: Los cupos deben estar entre 1 y 40. Intente de nuevo.");
        }
    }
    
    // VALIDACIÓN DE CRÉDITOS 
    int creditos = 0;
    while (creditos < 1 || creditos > 3) {
        System.out.println("Creditos (1 al 3): ");
        creditos = teclado.nextInt();
        teclado.nextLine();
        
        if (creditos < 1 || creditos > 3) {
            System.out.println("Error: Los créditos deben estar entre 1 y 3. Intente de nuevo.");
        }
    }
    
    //Uso el constructor de materia (El orden)
    
    Materia nuevaMateria = new Materia (codigo, nombreMat, cupos, creditos);
    mapaMaterias.put (codigo, nuevaMateria);
    System.out.println("Materia creada exitosamente");
